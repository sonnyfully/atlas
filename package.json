{
  "name": "atlas",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @atlas/web dev",
    "build:web": "pnpm --filter @atlas/web build",
    "atlas:prep": "tsx scripts/atlas_prep.ts",
    "atlas:smoke": "tsx scripts/atlas_smoke.ts",
    "smoke-test": "tsx scripts/smoke_test.ts",
    "test:collisions": "tsx --test apps/web/lib/collision-build.test.ts",
    "test:provenance": "tsx --test apps/web/lib/atlas-provenance.test.ts",
    "test:atlas-map-v1": "tsx scripts/test_atlas_map_v1.ts",
    "test:atlas-color": "tsx scripts/test_analysis_color_fallback.ts",
    "seed": "tsx scripts/seed_db.ts",
    "backfill:audio": "tsx scripts/backfill_audio_embeddings.ts",
    "test:upload": "bash scripts/test_upload.sh"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "helix-ts": "^1.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
